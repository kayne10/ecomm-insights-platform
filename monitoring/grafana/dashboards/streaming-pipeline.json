{
  "uid": "streaming-pipeline",
  "title": "Streaming Pipeline",
  "description": "Throughput, lag and health of Kafka, the Elasticsearch sinks and the Flink job. Provisioned from monitoring/grafana/dashboards/streaming-pipeline.json.",
  "tags": [
    "ecomm",
    "kafka",
    "flink",
    "elasticsearch"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 41,
  "version": 1,
  "links": [
    {
      "title": "Kibana insights",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "url": "http://localhost:5601/app/dashboards#/view/ecomm-insights"
    },
    {
      "title": "Flink UI",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "url": "http://localhost:8082"
    },
    {
      "title": "Prometheus targets",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "url": "http://localhost:9090/targets"
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Pipeline overview",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Events in / s",
      "id": 3,
      "description": "Events produced to Kafka per second, across all generated event topics.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(kafka_topic_partition_current_offset{topic=~\".+-events\", topic!=\"cart-abandoned-events\"}[1m]))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: ev/s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "blue",
                "value": 0.01
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "title": "Docs indexed / s",
      "id": 4,
