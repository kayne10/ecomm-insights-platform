        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
      "type": "stat",
      "title": "Carts abandoned",
      "id": 7,
      "description": "Abandoned carts detected by Flink in the selected time range.",
