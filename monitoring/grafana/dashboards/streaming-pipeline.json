      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(flink_taskmanager_job_task_operator_cartsAbandoned[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
