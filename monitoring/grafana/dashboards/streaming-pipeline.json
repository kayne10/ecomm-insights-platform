    {
      "type": "stat",
      "title": "Abandonment rate",
      "id": 8,
      "description": "Abandoned / (abandoned + converted) carts in the selected range, as decided by Flink.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(flink_taskmanager_job_task_operator_cartsAbandoned[$__range])) / (sum(increase(flink_taskmanager_job_task_operator_cartsAbandoned[$__range])) + sum(increase(flink_taskmanager_job_task_operator_cartsConverted[$__range])))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.3
              },
              {
                "color": "red",
                "value": 0.6
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "\u2013",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true
      }
    },
    {
