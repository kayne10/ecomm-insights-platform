    {
      "type": "stat",
      "title": "Elasticsearch health",
      "id": 11,
      "description": "Yellow is expected locally: a single node can't host replica shards.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 5,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(elasticsearch_cluster_health_status{color=\"green\"}) * 2 + max(elasticsearch_cluster_health_status{color=\"yellow\"})",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
