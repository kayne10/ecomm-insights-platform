            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "mappings": [
            {
              "type": "value",
              "options": {
                "2": {
                  "text": "green",
                  "color": "green"
                },
                "1": {
                  "text": "yellow (1 node)",
                  "color": "yellow"
                },
                "0": {
                  "text": "red",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
