#!/usr/bin/env bash
# Kafka Connect CLI.
# <name> is either an event name (e.g. `refund`, for the generated `refund_es_sink`)
# or a hand-written config in apps/connect/connectors/<name>.json.
set -euo pipefail

CONNECT_URL="${CONNECT_URL:-http://localhost:8083}"   # outside docker
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONNECTORS_DIR="$ROOT_DIR/apps/connect/connectors"

command -v jq >/dev/null || { echo "jq is required (brew install jq)" >&2; exit 1; }

usage() {
  cat <<USAGE
Kafka Connect CLI

Usage:
  kc list                       List connectors with their state
  kc apply <file>               Create or update connector from apps/connect/connectors/<file>.json
  kc apply-all                  Apply every .json in apps/connect/connectors
  kc status <name>              Show connector + task status (incl. task errors)
  kc restart <name>             Restart connector and its failed tasks
  kc pause|resume <name>        Pause or resume a connector
  kc delete <name>              Delete connector
  kc wait                       Block until the Connect REST API is up

Generated Elasticsearch sinks are created with `make sink`.

Examples:
  kc status refund
  kc pause add_to_cart

READY FOR INSIGHTS?
USAGE
}

config_file() {
  local file="$CONNECTORS_DIR/$1.json"
  [[ -f "$file" ]] || { echo "Config file not found: $file" >&2; exit 1; }
  echo "$file"
}

connector_name() {
  local file="$CONNECTORS_DIR/$1.json"
  if [[ -f "$file" ]]; then jq -r '.name' "$file"
  elif [[ "$1" == *_es_sink ]]; then echo "$1"
  else echo "$1_es_sink"   # generated sink for event <name>
  fi
}

wait_for_connect() {
  printf "Waiting for Kafka Connect at %s" "$CONNECT_URL"
  for _ in $(seq 1 60); do
    if curl -sf "$CONNECT_URL/connectors" >/dev/null; then echo " ✅"; return 0; fi
    printf "."; sleep 2
  done
  echo " ❌ timed out" >&2; exit 1
}

list_connectors() {
  curl -sf "$CONNECT_URL/connectors?expand=status" \
    | jq -r 'to_entries[] | "\(.key)\t\(.value.status.connector.state)\ttasks: \([.value.status.tasks[].state] | join(","))"' | sort | column -t -s $'\t'
}

apply_connector() {
  local file name
  file="$(config_file "$1")"
  name="$(connector_name "$1")"
  echo "Applying connector: $name"
  # PUT /config is an upsert: creates the connector if missing, updates it otherwise.
  jq '.config' "$file" \
    | curl -s -X PUT "$CONNECT_URL/connectors/$name/config" \
        -H "Content-Type: application/json" --data @- \
    | jq '{name, tasks: [.tasks[]?.task], error_code, message}'
}

apply_all() {
  shopt -s nullglob
  local files=("$CONNECTORS_DIR"/*.json)
  [[ ${#files[@]} -gt 0 ]] || { echo "No hand-written connectors in $CONNECTORS_DIR"; return 0; }
  for f in "${files[@]}"; do
    apply_connector "$(basename "$f" .json)"
  done
}

status_connector() {
  curl -s "$CONNECT_URL/connectors/$(connector_name "$1")/status" | jq .
}

restart_connector() {
  curl -s -X POST "$CONNECT_URL/connectors/$(connector_name "$1")/restart?includeTasks=true&onlyFailed=true" | jq .
}

pause_connector() {
  curl -s -X PUT "$CONNECT_URL/connectors/$(connector_name "$1")/$2"
  echo "$2: $(connector_name "$1")"
}

delete_connector() {
  local name; name="$(connector_name "$1")"
  echo "Deleting connector: $name"
  curl -s -X DELETE "$CONNECT_URL/connectors/$name"
  echo
}

need_arg() { [[ -n "${2:-}" ]] || { echo "Usage: kc $1 <name>" >&2; exit 1; }; }

cmd="${1:-}"
case "$cmd" in
  list) list_connectors ;;
  apply|create) need_arg "$cmd" "${2:-}"; apply_connector "$2" ;;
  apply-all|create-all) apply_all ;;
  status) need_arg "$cmd" "${2:-}"; status_connector "$2" ;;
  restart) need_arg "$cmd" "${2:-}"; restart_connector "$2" ;;
  pause|resume) need_arg "$cmd" "${2:-}"; pause_connector "$2" "$cmd" ;;
  delete) need_arg "$cmd" "${2:-}"; delete_connector "$2" ;;
  wait) wait_for_connect ;;
  *) usage ;;
esac
